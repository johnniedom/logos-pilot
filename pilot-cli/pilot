#!/usr/bin/env bash
# pilot — CLI for deploying and managing a Pilot agent on LEZ
#
# Usage: pilot <command> [options]
# Commands: deploy, verify, discover, configure, status, help
set -euo pipefail

PILOT_VERSION="0.1.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/lib"

# Load shared utilities
# shellcheck source=lib/common.sh
source "${LIB_DIR}/common.sh"

# ──────────────────────────────────────────────────────────────
# Help
# ──────────────────────────────────────────────────────────────
print_help() {
    cat <<EOF
${BOLD}pilot${RESET} v${PILOT_VERSION} — Sovereign Agent CLI for LEZ

${BOLD}USAGE${RESET}
  pilot <command> [options]

${BOLD}COMMANDS${RESET}
  deploy      Interactive deployment wizard (identity, LLM, funding)
  chat        Talk to your agent in the terminal (LLM-powered)
  verify      Collect and display verification evidence for evaluators
  discover    Discover peer agents on the network
  configure   Update agent configuration
  status      Show current agent status
  help        Show this help message

${BOLD}GLOBAL OPTIONS${RESET}
  --data-dir DIR    Set data directory (default: /tmp/pilot-data)
  --module-path P   Set module library path (default: ./result/lib)
  --version         Show version
  --help            Show this help

${BOLD}EXAMPLES${RESET}
  pilot deploy --testnet
  pilot chat
  pilot verify --json-only
  pilot discover --timeout 30
  pilot status
  pilot configure llm.provider anthropic

${BOLD}ENVIRONMENT${RESET}
  PILOT_DATA_DIR       Data directory override
  PILOT_MODULE_PATH    Module library path override
  PILOT_LLM_PROVIDER   LLM provider (anthropic, openai, google, local, openrouter)
  PILOT_LLM_MODEL      LLM model identifier

EOF
}

# ──────────────────────────────────────────────────────────────
# Configure command (inline, no separate lib file needed)
# ──────────────────────────────────────────────────────────────
cmd_configure() {
    if [[ $# -lt 2 ]]; then
        cat <<'EOF'
Usage: pilot configure <key> <value>

Set a configuration value on the running pilot module.

Keys:
  llm.provider     LLM provider (anthropic, openai, google, local, openrouter)
  llm.model        LLM model identifier
  owner.address    Owner's Logos address
  spend.per_tx     Per-transaction spending limit
  spend.per_period Per-period spending limit
  spend.period     Spending period in seconds

Examples:
  pilot configure llm.provider anthropic
  pilot configure llm.model claude-sonnet-4-20250514
  pilot configure spend.per_tx 200
EOF
        exit 1
    fi

    local key="$1"
    local value="$2"

    require_cmd logoscore "Install logoscore from the Logos SDK"

    log_info "Setting ${key} = ${value}"
    local result
    result=$(pilot_call "metaConfigure(${key}, ${value})" 2>&1) || true

    if [[ "$result" == *"true"* ]]; then
        log_success "Configuration updated"
    else
        log_warn "Module returned: ${result:-empty}"
    fi
}

# ──────────────────────────────────────────────────────────────
# Status command (inline)
# ──────────────────────────────────────────────────────────────
cmd_status() {
    local json_output=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)  json_output=true; shift ;;
            --help)
                cat <<'EOF'
Usage: pilot status [options]

Show current agent status.

Options:
  --json    Output as JSON
  --help    Show this help
EOF
                exit 0
                ;;
            *)  log_error "Unknown option: $1"; exit 1 ;;
        esac
    done

    require_cmd logoscore "Install logoscore from the Logos SDK"

    local npk account_id balance status uptime
    npk=$(pilot_call "getAgentNpk()" 2>&1)         || npk="unavailable"
    account_id=$(pilot_call "getAccountId()" 2>&1)  || account_id="unavailable"
    balance=$(pilot_call "walletBalance()" 2>&1)     || balance="unavailable"
    status=$(pilot_call "metaStatus()" 2>&1)         || status="unavailable"
    uptime=$(get_uptime)

    if [[ "$json_output" == "true" ]]; then
        cat <<ENDJSON
{
  "npk": "${npk}",
  "account_id": "${account_id}",
  "balance": "${balance}",
  "status": "${status}",
  "uptime": "${uptime}"
}
ENDJSON
        return
    fi

    printf "\n"
    hrule "═" 40
    printf "  ${BOLD}Pilot Agent Status${RESET}\n"
    hrule "═" 40
    printf "\n"
    print_kv "NPK" "$npk" 12
    print_kv "Account" "$account_id" 12
    print_kv "Balance" "$balance" 12
    print_kv "Status" "$status" 12
    print_kv "Uptime" "$uptime" 12
    printf "\n"
}

# ──────────────────────────────────────────────────────────────
# Command dispatch
# ──────────────────────────────────────────────────────────────
main() {
    # Handle global flags before subcommand
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version)
                printf "pilot %s\n" "$PILOT_VERSION"
                exit 0
                ;;
            --data-dir)
                export PILOT_DATA_DIR="$2"
                shift 2
                ;;
            --module-path)
                export PILOT_MODULE_PATH="$2"
                shift 2
                ;;
            --help)
                print_help
                exit 0
                ;;
            -*)
                # Unknown global flag — might be a subcommand flag, stop processing
                break
                ;;
            *)
                # First non-flag argument is the subcommand
                break
                ;;
        esac
    done

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        deploy)
            source "${LIB_DIR}/arrow-select.sh"
            source "${LIB_DIR}/deploy.sh"
            deploy_main "$@"
            ;;
        chat)
            source "${LIB_DIR}/chat.sh"
            chat_main "$@"
            ;;
        verify)
            source "${LIB_DIR}/verify.sh"
            verify_main "$@"
            ;;
        discover)
            source "${LIB_DIR}/discover.sh"
            discover_main "$@"
            ;;
        configure)
            cmd_configure "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        help|--help|-h)
            print_help
            ;;
        *)
            log_error "Unknown command: ${cmd}"
            printf "\n"
            print_help
            exit 1
            ;;
    esac
}

main "$@"
